<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CoffeeEagle.Reader</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <ApplicationTitle>CoffeeEagle</ApplicationTitle>
    <ApplicationId>net.coffeewebjp.coffeeeagle.reader</ApplicationId>
    <ApplicationDisplayVersion>0.1.4</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <CoffeeEagleSigningProps>$(MSBuildProjectDirectory)\..\..\.tools\android-signing\CoffeeEagle.Reader.Signing.props</CoffeeEagleSigningProps>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\icon.png" ForegroundScale="0.65" Color="#0B0E12" />
    <MauiSplashScreen Include="Resources\AppIcon\icon.png" Color="#0B0E12" BaseSize="256,256" ForegroundScale="0.65" />
    <MauiImage Include="Resources\AppIcon\icon.png" BaseSize="256,256" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.1" />
  </ItemGroup>

  <Import Project="$(CoffeeEagleSigningProps)" Condition="Exists('$(CoffeeEagleSigningProps)')" />

  <Target
    Name="RequireCoffeeEagleReleaseSigning"
    BeforeTargets="PrepareForBuild"
    Condition="'$(Configuration)' == 'Release' and !Exists('$(CoffeeEagleSigningProps)')">
    <Error Text="CoffeeEagleの共通Release署名がありません。scripts\android\Restore-CoffeeEagleReaderSigning.ps1 で正本の署名ファイルを復元してください。新しい鍵を生成すると既存アプリを更新できません。" />
  </Target>

</Project>





