<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CoffeeEagle.Offline/CoffeeEagle.Offline.csproj" />
    <Compile Include="../../src/CoffeeEagle.Reader/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../src/CoffeeEagle.Reader/Services/GoogleDriveLibraryService*.cs"
             Exclude="../../src/CoffeeEagle.Reader/Services/GoogleDriveLibraryService.Auth.cs"
             Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../src/CoffeeEagle.Reader/Services/EagleLibraryIndexer*.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
